# Copy this file to .env and fill in what you need. .env is gitignored.
# CiteWise reads only keys that start with CITEWISE_ from this file.
# OPENAI_API_KEY is honored only when it is already exported in your process
# environment; it is not read from .env. Existing variables are never overridden.
# Never commit a real key.

# API key for online mode and for --embeddings openai. Leave empty for offline.
CITEWISE_API_KEY=

# Optional OpenAI-compatible endpoint. Examples:
#   http://localhost:11434/v1                 (Ollama)
#   https://your-openai-compatible-endpoint/v1  (DeepSeek, vLLM, etc.)
CITEWISE_BASE_URL=

# Chat model name used for online answers.
CITEWISE_MODEL=gpt-4o-mini

# Embedding model used only when ingesting with --embeddings openai.
CITEWISE_EMBEDDING_MODEL=text-embedding-3-small
